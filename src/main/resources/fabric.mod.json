{
	"schemaVersion": 1,
	"id": "gradient_wand",
	"version": "${version}",
	"name": "Gradient Wand",
	"description": "A mod that adds several gradient wands to Minecraft",
	"authors": [
		"Tyler (ddynamix)"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/ddynamix/Minecraft-Gradient-Tool-Mod"
	},
	"license": "MIT",
	"icon": "assets/gradient-wand/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.tyler.gradientwand.GradientWand"
		],
		"client": [
			"net.tyler.gradientwand.GradientWandClient"
		],
		"fabric-datagen": [
			"net.tyler.gradientwand.GradientWandDataGenerator"
		]
	},
	"mixins": [
		"gradient_wand.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}