{
	"schemaVersion": 1,
	"id": "${id}",
	"version": "${version}",
	"name": "${name}",
	"description": "A mod that adds gradient wands to Minecraft.",
	"authors": [
		"Tyler (ddynamix)"
	],
	"contact": {
		"sources": "https://github.com/ddynamix/Minecraft-Gradient-Tool-Mod"
	},
	"license": "MIT",
	"icon": "assets/gradient_wand/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.tyler.gradientwand.GradientWand"
		],
		"client": [
			"net.tyler.gradientwand.GradientWandClient"
		],
		"fabric-datagen": [
			"net.tyler.gradientwand.GradientWandDataGenerator"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "${minecraft}",
		"java": ">=${java}",
		"fabric-api": "*"
	}
}